# API keys are left EMPTY on purpose, matching server/.env.example. An empty
# value reads as "unset", which every guard already handles honestly; filler
# text like `your-api-key-here` reads as a configured key and gets sent to the
# vendor, which answers 401 and surfaces as an opaque 500. Fill these in or
# leave them blank — never leave a placeholder.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
PORT=3001
DATABASE_URL="file:./dev.db"

# Registration is closed by default (F4a / #5): an email must be on the
# AllowedEmail table to create an account. Comma-separated addresses here are
# seeded into that table on server start ONLY when it is empty, so a fresh
# deployment isn't locked out of its own signup. It will not re-add an address
# an admin has since removed.
ALLOWLIST_BOOTSTRAP_EMAILS=you@example.com

# Local-dev escape hatch for corporate proxies with self-signed certs.
# Disables TLS certificate validation for ALL outbound requests, so the server
# refuses to start with this set when NODE_ENV=production. Leave unset.
# ALLOW_INSECURE_TLS=1

# Spend gates (F4b / #6). Two independent ceilings, both in whole cents.
# The per-user daily cap resets at midnight UTC and admins may exceed it.
# The global monthly ceiling protects the actual bill and is NOT bypassable
# by anyone. A malformed value here falls back to the default rather than
# disabling the gate.
QUOTA_DAILY_PER_USER_CENTS=50
QUOTA_MONTHLY_GLOBAL_CENTS=2000
QUOTA_ADMIN_BYPASS=true
