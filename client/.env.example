# Vite build-time env. Leave empty for local dev (Vite proxy handles /api).
# For deployed builds, set to the server's origin, e.g.
# VITE_API_BASE_URL=https://storybook-server.onrender.com
VITE_API_BASE_URL=

# Vite base path for subpath deploys (e.g., GitHub Pages at /repo).
# Leave unset for local dev or deploys at root.
# Set to /storybook/ for the GitHub Pages deploy at slickg0ose.github.io/storybook/.
VITE_BASE_PATH=
