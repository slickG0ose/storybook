# StoryBook Storefront — server env vars
# Copy to .env and fill in real values. Never commit .env (gitignored).

# Prisma SQLite database location
DATABASE_URL="file:./dev.db"

# Render deploy (Postgres) example — the actual URL is set in Render's
# dashboard from the Postgres service's connection string. Schema for
# Postgres deploys lives at prisma/postgres/schema.prisma (migrations in
# prisma/postgres/migrations/, applied by `prisma migrate deploy`).
# DATABASE_URL="postgresql://user:pass@host:5432/storybook"

# Anthropic API key — story generation and revision
ANTHROPIC_API_KEY=

# Image generation provider selector: fal | openai (defaults to fal)
IMAGE_PROVIDER=fal

# Fal.ai API key — illustration generation (default provider)
FAL_KEY=

# Optional: Fal image model override (defaults to fal-ai/flux-pro/v1.1)
# FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1

# OpenAI API key — illustration generation (fallback provider)
OPENAI_API_KEY=

# Optional: OpenAI image model override (defaults to gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Illustration storage backend: local | r2 (defaults to local; blank = local).
# local writes PNGs to server/public/illustrations — right for dev, tests, and
# offline work, and needs none of the R2_* vars below. Any other value (a typo)
# fails the server at boot rather than silently falling back to disk.
# Setup for r2: docs/conventions/data.md §Illustration storage.
STORAGE_BACKEND=local

# Cloudflare R2 — read only when STORAGE_BACKEND=r2, and then these FOUR are
# required: boot fails with an error naming whichever are missing or blank.
# Account ID (Cloudflare dashboard > R2 overview). The S3 endpoint is derived
# from it: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# Bucket name
R2_BUCKET=
# R2 API token credentials (Object Read & Write, scoped to the bucket above)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public read URL of the bucket, no trailing slash needed (it is stripped).
# UNUSED and optional (#237). Media is served through signed links and a
# presigned R2 GET; the server no longer reads this.
# R2_PUBLIC_BASE_URL=

# Optional: HTTP port override (defaults to 3001)
# PORT=3001

# Optional: comma-separated CORS allowlist. Origins only — scheme + host, no
# path, no trailing slash. Leave unset in local dev (every origin is allowed,
# which is what Vite on :5173 and Playwright need). In production, unset means
# every origin is still allowed *and* the server warns at startup; the Render
# Blueprint sets the real value. See docs/deploy-spike-render.md.
# CORS_ORIGIN=https://slickg0ose.github.io

# Optional: proxies to trust when reading X-Forwarded-For, which decides the address
# the login rate limit keys on. Defaults to 1 in production and 0 elsewhere; prod on
# Render needs 3, which render.yaml sets. Too high lets a client forge its address and
# too low can defeat the limit, so re-run the check in ADR-030 after changing it.
# TRUST_PROXY_HOPS=3

# Optional: bearer-token lifetime in days (absolute, not sliding). Integer 1 to 90;
# unset, blank or anything else uses 30 (invalid values also log one warning).
# TOKEN_TTL_DAYS=30

# Optional: commerce kill switch for /api/cart and /api/orders (#216, ADR-036). Off only
# for an explicit false / 0 / off / no (trimmed, case-insensitive); unset, blank or any
# other value leaves commerce ON. While off, every route under both prefixes answers
# 503 {"error", "code":"COMMERCE_DISABLED"}. Read per request, so no restart-order trap.
# COMMERCE_ENABLED=false

# Signed media URLs (#237). Links on /illustrations and /uploads are HMAC-signed
# and expire. Unset in dev is fine: a fixed dev secret is used. In production an
# unset secret falls back to a random per-process one (links break on restart).
# MEDIA_URL_SECRET=            # >= 32 characters
# MEDIA_URL_SECRET_PREVIOUS=   # verify-only old secret, for rotation
# MEDIA_URL_TTL_MINUTES=60     # integer 5-1440; links live 1 to 2 windows
# enforce (default when unset) refuses unsigned links with 403. Until the API
# signs its URLs, local dev needs lenient or every image 403s:
# MEDIA_URL_MODE=lenient
