# StoryBook Storefront — server env vars
# Copy to .env and fill in real values. Never commit .env (gitignored).

# Prisma SQLite database location
DATABASE_URL="file:./dev.db"

# Render deploy (Postgres) example — the actual URL is set in Render's
# dashboard from the Postgres service's connection string. Schema for
# Postgres deploys lives at prisma/schema.postgresql.prisma.
# DATABASE_URL="postgresql://user:pass@host:5432/storybook"

# Anthropic API key — story generation and revision
ANTHROPIC_API_KEY=

# Image generation provider selector: fal | openai (defaults to fal)
IMAGE_PROVIDER=fal

# Fal.ai API key — illustration generation (default provider)
FAL_KEY=

# Optional: Fal image model override (defaults to fal-ai/flux-pro/v1.1)
# FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1

# OpenAI API key — illustration generation (fallback provider)
OPENAI_API_KEY=

# Optional: OpenAI image model override (defaults to gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: HTTP port override (defaults to 3001)
# PORT=3001

# Optional: comma-separated CORS allowlist. Origins only — scheme + host, no
# path, no trailing slash. Leave unset in local dev (every origin is allowed,
# which is what Vite on :5173 and Playwright need). In production, unset means
# every origin is still allowed *and* the server warns at startup; the Render
# Blueprint sets the real value. See docs/deploy-spike-render.md.
# CORS_ORIGIN=https://slickg0ose.github.io
