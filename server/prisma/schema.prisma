generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  password_hash String
  token         String?
  role          String    @default("user")
  deleted_at    DateTime?
  created_at    DateTime  @default(now())

  books    Book[]
  orders   Order[]
  feedback Feedback[]
}

model Book {
  id              String   @id @default(uuid())
  title           String
  author          String
  description     String
  theme           String
  age_range       String
  cover_emoji     String
  cover_color     String
  cover_url       String?
  price           Float
  is_featured     Boolean  @default(false)
  is_user_created Boolean  @default(false)
  status          String   @default("published")
  version         Int      @default(1)
  characters_json String?
  style_descriptor String?
  style_reference_url String?
  // Presentation-only (#113). Both non-null with defaults that reproduce the
  // pre-#113 rendering exactly, so every existing row is visually unchanged.
  // Age-derived values are written at creation time only, never as a runtime
  // fallback — see spec §Ruling 4. Deliberately NOT snapshotted into
  // BookVersion — see spec §Ruling 2.
  font_family String @default("fredoka")   // 'fredoka' | 'nunito' | 'atkinson' | 'lexend'
  text_size   String @default("standard")  // 'cozy' | 'standard' | 'large' | 'xlarge'
  // Which image provider + base model produced this book's art. Written lazily
  // on the first successful image write (see services/imagePin.ts), NOT at
  // creation time — the pin describes art that exists, not an intention.
  // Null means "not yet pinned"; resolveImagePin() infers and back-fills.
  image_provider  String?  // 'openai' | 'fal'
  image_model     String?  // 'gpt-image-1' | 'fal-ai/flux-pro/v1.1'
  created_by      String?
  deleted_at      DateTime?
  created_at      DateTime @default(now())
  // Hero rotation (spec: .code-captain/specs/hero-rotation/spec.md). Both
  // columns are additive; every pre-existing row keeps its data and comes out
  // not-eligible and not-consented, so the pool is empty until opted into.
  //
  // Editorial quality — "this is good enough for the front page." Admin-writable
  // via PUT /api/admin/books/:id/hero-eligible. Defaults false, so every
  // existing row is out of the hero pool until someone deliberately opts it in.
  is_hero_eligible Boolean @default(false)
  // Permission for promotional display outside this book's own detail page.
  // Deliberately has NO API writer — the only thing that sets it is the
  // demo-seed fixture, i.e. the operator consenting to the operator's own demo
  // book. Admin authority and owner consent are different keys on purpose;
  // see the spec's §"The consent seam".
  hero_consent_at DateTime?

  creator    User?         @relation(fields: [created_by], references: [id])
  pages      Page[]
  versions   BookVersion[]
  illustration_versions IllustrationVersion[]
  narration_clips NarrationClip[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  feedback   Feedback[]
}

model IllustrationVersion {
  id           Int      @id @default(autoincrement())
  book_id      String
  page_number  Int
  version      Int
  url          String
  feedback     String?
  created_at   DateTime @default(now())

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([book_id, page_number, version])
}

// Generated read-aloud audio, one row per (book, slot, voice, model, text).
// Spec: .code-captain/specs/generated-narration/spec.md. The text hash is in the
// key, so revised text never serves stale audio; segments are read and written
// whole (ADR-002 JSON-column precedent), never queried.
model NarrationClip {
  id            Int      @id @default(autoincrement())
  book_id       String
  slot          String   // 'cover' | 'end' | 'p<N>'
  voice_id      String   // 'af_heart' | 'am_michael'
  model         String   // 'fal-ai/kokoro/american-english'
  text_hash     String   // sha256 hex of the synthesised text
  chars         Int      // what was billed against
  segments_json String   // [{ index, start, end, key, durationMs }]
  created_by    String?  // who paid
  created_at    DateTime @default(now())

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([book_id, slot, voice_id, model, text_hash])
}

model BookVersion {
  id              Int      @id @default(autoincrement())
  book_id         String
  version         Int
  pages_json      String
  description     String?
  characters_json String?
  created_at      DateTime @default(now())

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([book_id, version])
}

model Page {
  id                       Int     @id @default(autoincrement())
  book_id                  String
  illustration_url         String?
  page_number              Int
  text                     String
  illustration_description String

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([book_id, page_number])
}

model CartItem {
  id         Int    @id @default(autoincrement())
  session_id String
  book_id    String
  quantity   Int    @default(1)

  book Book @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([session_id, book_id])
}

model Order {
  id             String   @id @default(uuid())
  session_id     String
  user_id        String?
  customer_name  String
  customer_email String
  total          Float
  status         String   @default("confirmed")
  created_at     DateTime @default(now())

  user  User?       @relation(fields: [user_id], references: [id])
  items OrderItem[]
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  order_id String
  book_id  String
  title    String
  quantity Int
  price    Float

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [book_id], references: [id])
}

// Registration allowlist (F4a / #5). Email is the primary key — an email is
// either on the list or it isn't, and there's nothing else to identify a row
// by. `added_by` is a free-text admin email rather than a User relation so a
// bootstrap entry can be created before any user exists.
model AllowedEmail {
  email      String   @id
  added_by   String?
  note       String?
  created_at DateTime @default(now())
}

// Spend ledger (F4b / #6). One row per paid AI call, written AFTER the call
// succeeds so a failed request doesn't consume quota. Indexed on
// (user_id, created_at) because every read is a windowed sum over one of those
// two axes: per-user-per-day, or global-per-month.
model UsageLog {
  id         Int      @id @default(autoincrement())
  user_id    String
  kind       String
  cost_cents Int
  created_at DateTime @default(now())

  @@index([user_id, created_at])
  @@index([created_at])
}

// Tester feedback (#157). One row per submission. user_id is the authenticated
// submitter (never taken from the body); session_id is the cart-session UUID the
// client already holds — an unverified correlation hint, not an identity.
model Feedback {
  id                 String   @id @default(uuid())
  user_id            String
  session_id         String
  category           String // 'bug' | 'idea' | 'praise' | 'other' — enforced in Zod
  message            String
  route              String // router pathname + search, basename-stripped, starts with '/'
  book_id            String?
  user_agent         String? // from the request header, server-side, truncated to 512
  viewport_width     Int
  viewport_height    Int
  theme              String // 'light' | 'dark'
  client_build       String? // VITE_APP_COMMIT at build time; null in local dev
  server_build       String? // RENDER_GIT_COMMIT at request time; null off Render
  // JSON.stringify of the request's recent_errors string[] (open question 3).
  // Null on rows written without errors; readers parse null back to [].
  recent_errors_json String?
  status             String   @default("new") // 'new' | 'triaged' | 'done'
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [book_id], references: [id], onDelete: SetNull)

  @@index([status, created_at])
  @@index([user_id, created_at])
}
