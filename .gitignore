node_modules/
dist/
.env
*.db
# SQLite writes sidecars next to the database; `*.db` does not match them (#97).
# A crashed run leaves these behind and they would otherwise show up as untracked.
*.db-journal
*.db-wal
*.db-shm
data.json
.DS_Store
.claude/settings.local.json
.claude/hooks/read.log
.claude/worktrees/
e2e/playwright-report/
e2e/test-results/
server/.backups/
# server/public/ holds generated content (uploads, generated illustrations).
# Ignore everything inside it by default, then re-include the per-book
# subdirectories that hold committed demo-seed fixture art (Sunny's PNGs and the
# six canonical seed books' JPEGs). Note: we ignore
# `server/public/*` (contents) rather than `server/public/` (the dir itself)
# because gitignore cannot re-include a file whose parent directory is ignored.
# Add a new `!server/public/illustrations/<book-id>/` line per fixture book.
server/public/*
!server/public/illustrations/
server/public/illustrations/*
!server/public/illustrations/b2fa23cf-3156-4b89-83e7-82d98c32c8b7/
!server/public/illustrations/luna-star-garden/
!server/public/illustrations/captain-bear-submarine/
!server/public/illustrations/robot-learns-to-hug/
!server/public/illustrations/dinosaur-bakery/
!server/public/illustrations/cloud-painter/
!server/public/illustrations/brave-little-seed/
# server/public/hero/ is the opposite case: nothing in it is generated at runtime.
# Every file is a derived, byte-budgeted, hand-committed hero-rotation frame produced by
# server/scripts/derive-hero-frames.sh, so the whole directory is re-included with no
# per-book line. Budget is enforced by server/src/__tests__/heroFrameAssets.test.ts.
!server/public/hero/
server/test-results/

# Playwright MCP scratch (screenshots, snapshots, console logs)
.playwright-mcp/

# Raw PNG cache for the seed-book art generator (server/scripts/generate-seed-art.ts).
server/.seed-art/
